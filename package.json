{
  "name": "@lightsoft-pe/seeding",
  "version": "0.1.0",
  "description": "Database-agnostic, Laravel-inspired seeding library",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seeding": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./peru": {
      "import": {
        "types": "./dist/peru/index.d.ts",
        "default": "./dist/peru/index.js"
      },
      "require": {
        "types": "./dist/peru/index.d.cts",
        "default": "./dist/peru/index.cjs"
      }
    },
    "./cosmos": {
      "import": {
        "types": "./dist/cosmos/index.d.ts",
        "default": "./dist/cosmos/index.js"
      },
      "require": {
        "types": "./dist/cosmos/index.d.cts",
        "default": "./dist/cosmos/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify:exports": "node scripts/verify-exports.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:exports"
  },
  "peerDependencies": {
    "@azure/cosmos": "^4.10.1",
    "@faker-js/faker": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@azure/cosmos": {
      "optional": true
    }
  },
  "devDependencies": {
    "@azure/cosmos": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "author": "Lightsoft PE",
  "keywords": [
    "seeding",
    "seeder",
    "factory",
    "faker",
    "cosmos",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightsoftTeam/seeding.git"
  },
  "homepage": "https://github.com/LightsoftTeam/seeding#readme",
  "bugs": {
    "url": "https://github.com/LightsoftTeam/seeding/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
